# Postgres connection. The role must be allowed to `set role authenticated` (a superuser or a member of it).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/networkmanager
# Public URL of the app, used in email links.
APP_URL=http://localhost:3000
# Optional. Without it, mail is only written to identity.outbox (visible in dev).
SMTP_URL=
MAIL_FROM="Network Manager <no-reply@example.com>"
# Shared secret for POST /api/cron/renewals (scheduler sends it as a Bearer token).
CRON_SECRET=
RETENTION_DAYS=90
